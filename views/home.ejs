<%- include('partials/header') %>

  <div class="grid-movies">

    <% movies.forEach(movie => { %>
        <div id="movie-<%= movie.id %>" class="movie-card" onclick="showDetails()" onmouseover="showDetails(<%= movie.id %>)" onmouseout="hideDetails(<%= movie.id %>)">
        <% if (movie.poster_path) { %>
          <img src="https://image.tmdb.org/t/p/w200<%= movie.poster_path %>" alt="<%= movie.title %>">
        <% } else { %>
          <p>Sem imagem</p>
        <% } %>

        <h2><%= movie.title %></h2>

        <div class="movie-details" id="details-<%= movie.id %>" onclick="showDetailsModal(<%= movie.id %>)">
            <p><%= movie.title %></p>
            <p><%= movie.vote_average.toFixed(1) %> <i class="fa-solid fa-star"></i> (<%= movie.popularity.toFixed(1) %>)K</p> 
            <p><%= movie.overview.substring(0, 100) %>...</p>
        </div>
      </div>
    <% }); %>

  </div>

<%- include('partials/footer') %>